{
  "name": "dsh-desktop",
  "version": "0.0.3",
  "description": "DeepSeek Harness desktop app (Electron shell) — 自带 dsh 服务与手机远程访问",
  "main": "main.js",
  "author": "DeepSeek Harness",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "postinstall": "node apply-dsh-picker-fix.js && node apply-dsh-ui-patches.js"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/dsh": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-atomic-write": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-output-retention": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-telemetry": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-spill": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-in-process-driver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow": "^0.1.0-rc.6",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.deepseekharness.desktop",
    "productName": "DeepSeek Harness",
    "asar": false,
    "npmRebuild": false,
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "mobile.js",
      "mobile-api.js",
      "tunnel.js",
      "preload.js",
      "loading.html",
      "mobile-panel.html",
      "mobile-panel-preload.js",
      "icon.ico",
      "vendor/**",
      "mobile-ui/**",
      "node_modules/**",
      "!node_modules/electron/**",
      "!node_modules/.bin/**",
      "!**/*.map",
      "!**/*.md",
      "!**/*.markdown",
      "!**/README*",
      "!**/CHANGELOG*",
      "!**/LICENSE*",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!**/benchmark/**",
      "!**/benchmarks/**",
      "!**/examples/**",
      "!**/example/**",
      "!**/.github/**",
      "!**/.vscode/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness",
      "include": "installer.nsh",
      "artifactName": "DeepSeek-Harness-${version}-Setup.exe"
    },
    "portable": {
      "artifactName": "DeepSeek-Harness-${version}-portable.exe"
    }
  }
}
